 		return -EINVAL;
@@ -2623,16 +2626,38 @@ static ssize_t ath12k_write_stats_disabl
 		for (i = 0; i < ab->num_radios; i++) {
 			pdev = &ab->pdevs[i];
 			if (pdev && pdev->ar) {
+				if (ath12k_mesh_metric_offload) {
