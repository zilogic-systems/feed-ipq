+static ssize_t ath12k_manage_link_metrics_update(struct file *file,
+					  const char __user *user_buf,
+					  size_t count, loff_t *ppos)
+{
+	struct ath12k_base *ab = file->private_data;
+	struct ath12k_pdev *pdev;
+	struct ath12k *ar;
+	struct ath12k_link_vif *arvif;
+	int ret, i;
+	u32 mask = 0;
+	bool link_metrics_update;
+	char buf[20] = {0};
+
+	if (count > 20)
+		return -EFAULT;
+
+	ret = copy_from_user(buf, user_buf, count);
+	if (ret)
+		return -EFAULT;
+
+	if (strstr(buf, "disable"))
+		link_metrics_update = false;
+	else if (strstr(buf, "enable"))
+		link_metrics_update = true;
+	else
+		return -EINVAL;
+
+	/* If stats are enabled, no need to specifically ask
+	 * for ENHANCED stats
+	 */
+	if (!ab->stats_disable)
+		return count;
+
+	if (!ath12k_mesh_metric_offload) {
+		ath12k_err(ab, "Mesh Metric offload feature not enabled");
+		return -EINVAL;
+	}
+
+	for (i = 0; i < ab->num_radios; i++) {
+		pdev = &ab->pdevs[i];
+		if (pdev && pdev->ar) {
+			ar = pdev->ar;
+			mutex_lock(&ar->conf_mutex);
+			list_for_each_entry(arvif, &ar->arvifs, list) {
+				/* Do not request for any FW stats if there is a
+				 * non-11s VAP present in this radio
+				 */
+				if (arvif->vdev_subtype != WMI_VDEV_SUBTYPE_MESH_11S) {
+					mutex_unlock(&ar->conf_mutex);
+					return count;
+				}
+			}
+			mutex_unlock(&ar->conf_mutex);
+			/* If the link metrics update state is true,
+			 * request for ENHANCED stats from FW.
+			 *
+			 * It is fine to keep the same logic in stats_disable as
+			 * user may decide to disable stats again after enabling
+			 * link metrics here - so ENHANCED_STATS has to be requested
+			 * again.
+			 *
+			 * If link metrics update was disabled initially and then
+			 * stats are disabled, then it is necessary to disable
+			 * link metrics again.
+			 */
+			if (link_metrics_update) {
+				ab->is_link_metrics_update_enabled = true;
+				mask = HTT_PPDU_STATS_ENHANCED_TX_COMPLN;
+			} else
+				ab->is_link_metrics_update_enabled = false;
+
+			ath12k_info (ab, "Path selection metrics update has been %s",
+					link_metrics_update ? "enabled" : "disabled");
+			ath12k_info(ab, "Requesting ppdu stats with mask 0x%x", mask);
+			ath12k_dp_tx_htt_h2t_ppdu_stats_req(pdev->ar, mask);
+		}
+	}
+
+	ret = count;
+	return ret;
+}
+
+static ssize_t ath12k_read_link_metrics_update(struct file *file,
+					 char __user *user_buf,
+					 size_t count, loff_t *ppos)
+{
+	struct ath12k_base *ab = file->private_data;
+	char buf[32];
+	size_t len;
+
+	len = scnprintf(buf, sizeof(buf), "%u\n", ab->is_link_metrics_update_enabled);
+
+	return simple_read_from_buffer(user_buf, count, ppos, buf, len);
+}
+
+static const struct file_operations fops_link_metrics_update = {
+	.open = simple_open,
+	.write = ath12k_manage_link_metrics_update,
+	.read = ath12k_read_link_metrics_update,
+};
+
 static ssize_t ath12k_write_rx_hash_ix3(struct file *file,
 				        const char __user *ubuf,
 				        size_t count, loff_t *ppos)
@@ -3337,6 +3463,9 @@ int ath12k_debugfs_pdev_create(struct at
 	debugfs_create_file("stats_disable", 0600, ab->debugfs_soc, ab,
 			    &fops_soc_stats_disable);
 
+	debugfs_create_file("link_metrics_update", 0600, ab->debugfs_soc, ab,
+			    &fops_link_metrics_update);
+
 	debugfs_create_file("rx_hash_ix2", 0600, ab->debugfs_soc, ab,
 			    &fops_soc_rx_hash_ix2);
 
