--- a/drivers/net/wireless/ath/ath12k/mac.c
+++ b/drivers/net/wireless/ath/ath12k/mac.c
@@ -10767,7 +10767,8 @@ static void ath12k_mac_op_tx(struct ieee
 				break;
 			case ATH12K_HW_TXRX_NATIVE_WIFI:
 				ath12k_dp_tx_encap_nwifi(skb);
-				if (vif->type == NL80211_IFTYPE_MESH_POINT)
+				if (!ath12k_mesh_metric_offload &&
+						vif->type == NL80211_IFTYPE_MESH_POINT)
 					skb->is_from_recycler = 0;
 				skb_cb->flags |= ATH12K_SKB_TX_STATUS;
 				ret = ath12k_dp_tx_hw_enqueue(arvif, skb);
@@ -11264,6 +11265,23 @@ int ath12k_mac_radio_start(struct ath12k
 		}
 	}
 
+	/* When mesh metric offload feature is enabled,
+	 * there is a possibility that the link_metrics_update_enabled
+	 * might have been set before, when user disables all the stats
+	 * and HTT_ENHANCED_PPDU_STATS would have been requested to fw.
+	 * Ensure the same state is maintained when the radio is started
+	 */
+	if (ath12k_mesh_metric_offload && ab->stats_disable) {
+		if (ab->is_link_metrics_update_enabled) {
+			ret = ath12k_dp_tx_htt_h2t_ppdu_stats_req(ar,
+							  HTT_PPDU_STATS_ENHANCED_TX_COMPLN);
+			if (ret) {
+				ath12k_err(ab, "failed to req ppdu stats: %d\n", ret);
+				goto err;
+			}
+		}
+	}
+
 	ret = ath12k_wmi_pdev_set_param(ar, WMI_PDEV_PARAM_MESH_MCAST_ENABLE,
 					1, pdev->pdev_id);
 
