+
+	skb = cfg80211_vendor_event_alloc(wiphy, NULL,
+					  NLMSG_DEFAULT_SIZE,
+					  QCA_NL80211_VENDOR_SUBCMD_RM_GENERIC_INDEX, GFP_KERNEL);
+	if (!skb) {
+		ath12k_err(NULL, "rm generic pb failed to allocate skb\n");
+		return -ENOMEM;
+	}
+
+	if (nla_put_u8(skb, QCA_WLAN_VENDOR_ATTR_RM_GENERIC_SERVICE_ID,
+		       QCA_WLAN_VENDOR_RM_POWER_BOOST_SERVICE)) {
+		ath12k_err(NULL, "rm generic pb failed to put vendor id\n");
+		kfree_skb(skb);
+		return -ENOMEM;
+	}
+
+	if (nla_put_u8(skb, QCA_WLAN_VENDOR_ATTR_RM_GENERIC_CATEGORY,
+		       QCA_WLAN_VENDOR_ATTR_GENERIC_CATEGORY_APP_INIT)) {
+		ath12k_err(NULL, "rm generic pb failed to put category app init id\n");
+		kfree_skb(skb);
+		return -ENOMEM;
+	}
+
+	if (nla_put_string(skb,
+			   QCA_WLAN_VENDOR_ATTR_RM_GENERIC_RELAYFS_FILE_NAME_PMLO,
+			   ar->ab->ag->pb_rfs_path)) {
+		ath12k_err(NULL, "rm generic pb failed to put relayfs path\n");
+		kfree_skb(skb);
+		return -ENOMEM;
+	}
+
+	cfg80211_vendor_event(skb, GFP_KERNEL);
+	return 0;
+}
