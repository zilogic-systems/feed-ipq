From 25dafa7599e5de0dbb46aece5c8ae4f9bd5ba194 Mon Sep 17 00:00:00 2001
From: Vinith Kumar R <quic_vinithku@quicinc.com>
Date: Wed, 27 Nov 2024 12:10:27 +0530
Subject: [PATCH] wifi: ath12k: drop corrupted packets for invalid band from
 WBM error ring

Currently, warn_on is getting trigger due to the presence of
corrupted packets associated with an invalid band from the
WBM error ring.
This issue can lead to unnecessary warnings and potential disruptions

Hence, add a check to drop the packets if it has invalid band and
originating from the WBM error path.

This will ensure corrupted packets are dropped and prevent the
warn_on trigger.

patch-dependency: none

Signed-off-by: Sarika Sharma <quic_sarishar@quicinc.com>
Signed-off-by: Vinith Kumar R <quic_vinithku@quicinc.com>
---
 drivers/net/wireless/ath/ath12k/dp_mon.c |  1 +
 drivers/net/wireless/ath/ath12k/dp_rx.c  | 50 ++++++++++++++----------
 drivers/net/wireless/ath/ath12k/dp_rx.h  |  5 ++-
 3 files changed, 34 insertions(+), 22 deletions(-)

--- a/drivers/net/wireless/ath/ath12k/dp_mon.c
+++ b/drivers/net/wireless/ath/ath12k/dp_mon.c
@@ -2279,6 +2279,7 @@ static int ath12k_dp_mon_rx_deliver(stru
 	bool fcs_err = false;
 
 	rx_info.filled = 0;
+	rx_info.is_invalid_rate_drop = 0;
 	rx_info.rx_status = rxs;
 
 	mon_skb = ath12k_dp_mon_rx_merg_msdus(ar, mpdu_idx, head_msdu,
--- a/drivers/net/wireless/ath/ath12k/dp_rx.c
+++ b/drivers/net/wireless/ath/ath12k/dp_rx.c
@@ -3255,7 +3255,7 @@ static void ath12k_dp_rx_h_rate(struct a
 	if (rx_info->filled & BIT_ULL(ATH12K_RX_INFO_SGI))
 		sgi = rx_info->sgi;
 
-	rx_info->is_invalid_mcs = false;
+	rx_info->is_invalid_rate_drop = false;
 
 	switch (pkt_type) {
 	case RX_MSDU_START_PKT_TYPE_11A:
@@ -3268,7 +3268,7 @@ static void ath12k_dp_rx_h_rate(struct a
 	case RX_MSDU_START_PKT_TYPE_11N:
 		rx_status->encoding = RX_ENC_HT;
 		if (rate_mcs > ATH12K_HT_MCS_MAX) {
-			rx_info->is_invalid_mcs = true;
+			rx_info->is_invalid_rate_drop = true;
 			ath12k_warn(ar->ab,
 				    "Received with invalid mcs in HT mode %d\n",
 				     rate_mcs);
@@ -3284,7 +3284,7 @@ static void ath12k_dp_rx_h_rate(struct a
 		rx_status->encoding = RX_ENC_VHT;
 		rx_status->rate_idx = rate_mcs;
 		if (rate_mcs > ATH12K_VHT_MCS_MAX) {
-			rx_info->is_invalid_mcs = true;
+			rx_info->is_invalid_rate_drop = true;
 			ath12k_warn(ar->ab,
 				    "Received with invalid mcs in VHT mode %d\n",
 				     rate_mcs);
@@ -3299,7 +3299,7 @@ static void ath12k_dp_rx_h_rate(struct a
 	case RX_MSDU_START_PKT_TYPE_11AX:
 		rx_status->rate_idx = rate_mcs;
 		if (rate_mcs > ATH12K_HE_MCS_MAX) {
-			rx_info->is_invalid_mcs = true;
+			rx_info->is_invalid_rate_drop = true;
 			ath12k_warn(ar->ab,
 				    "Received with invalid mcs in HE mode %d\n",
 				    rate_mcs);
@@ -3314,7 +3314,7 @@ static void ath12k_dp_rx_h_rate(struct a
 	case RX_MSDU_START_PKT_TYPE_11BE:
 		rx_status->rate_idx = rate_mcs;
 		if (rate_mcs > ATH12K_EHT_MCS_MAX) {
-			rx_info->is_invalid_mcs = true;
+			rx_info->is_invalid_rate_drop = true;
 			ath12k_warn(ar->ab,
 				    "Received with invalid mcs in EHT mode %d\n",
 				    rate_mcs);
@@ -3354,9 +3354,11 @@ static void ath12k_dp_rx_h_fetch_info(st
 	}
 }
 
-void ath12k_dp_rx_h_ppdu(struct ath12k *ar, struct ath12k_dp_rx_info *rx_info)
+void ath12k_dp_rx_h_ppdu(struct ath12k *ar, struct ath12k_dp_rx_info *rx_info,
+			 struct sk_buff *msdu)
 {
 	struct ieee80211_rx_status *rx_status = rx_info->rx_status;
+	struct ath12k_skb_rxcb *rxcb = ATH12K_SKB_RXCB(msdu);
 	u8 channel_num;
 	u32 center_freq, meta_data = 0;
 	struct ieee80211_channel *channel;
@@ -3391,9 +3393,16 @@ void ath12k_dp_rx_h_ppdu(struct ath12k *
 	}
 
 	if (unlikely(rx_status->band == NUM_NL80211_BANDS || !ar->ah->hw->wiphy->bands[rx_status->band])) {
-        ath12k_err(ar->ab, "sband is NULL for status band %d channel_num %d center_freq %d pdev_id %d\n",
-                    rx_status->band, channel_num, center_freq, ar->pdev_idx);
-
+		if (rxcb->err_rel_src == HAL_WBM_REL_SRC_MODULE_REO ||
+		    rxcb->err_rel_src == HAL_WBM_REL_SRC_MODULE_RXDMA) {
+			if(ath12k_debug_critical)
+				WARN_ON_ONCE(1);
+			rx_info->is_invalid_rate_drop = true;
+			return;
+		} else {
+			ath12k_err(ar->ab, "sband is NULL for status band %d channel_num %d center_freq %d pdev_id %d\n",
+				   rx_status->band, channel_num, center_freq, ar->pdev_idx);
+		}
 		spin_lock_bh(&ar->data_lock);
 		channel = ar->rx_channel;
 		if (channel) {
@@ -3630,9 +3639,9 @@ static int ath12k_dp_rx_process_msdu(str
 	if (*fast_rx)
 		return 0;
 
-	ath12k_dp_rx_h_ppdu(ar, rx_info);
+	ath12k_dp_rx_h_ppdu(ar, rx_info, msdu);
 
-	if (unlikely(rx_info->is_invalid_mcs)) {
+	if (unlikely(rx_info->is_invalid_rate_drop)) {
 		ret = -EINVAL;
 		goto free_out;
 	}
@@ -4014,6 +4023,7 @@ try_again:
 		}
 
 		rx_info.filled = 0;
+		rx_info.is_invalid_rate_drop = 0;
 		rx_info.rx_status = &rx_status;
 		ret = ath12k_dp_rx_process_msdu(ar, msdu, &msdu_list, &rx_info,
 						&fast_rx);
@@ -4133,6 +4143,7 @@ static int ath12k_dp_rx_h_verify_tkip_mi
 		return 0;
 
 	rx_info.filled = 0;
+	rx_info.is_invalid_rate_drop = 0;
 	rx_info.rx_status = rxs;
 
 	hdr = (struct ieee80211_hdr *)(msdu->data + hal_rx_desc_sz);
@@ -4175,9 +4186,9 @@ mic_fail:
 		return -EINVAL;
 	}
 
-	ath12k_dp_rx_h_ppdu(ar, &rx_info);
+	ath12k_dp_rx_h_ppdu(ar, &rx_info, msdu);
 
-	if (unlikely(rx_info.is_invalid_mcs))
+	if (unlikely(rx_info.is_invalid_rate_drop))
 		return -EINVAL;
 
 	ath12k_dp_rx_h_undecap(ar, msdu, rx_desc,
@@ -5015,9 +5026,8 @@ static int ath12k_dp_rx_h_null_q_desc(st
 		goto exit;
 	}
 
-	ath12k_dp_rx_h_ppdu(ar, rx_info);
-
-	if (unlikely(rx_info->is_invalid_mcs)) {
+	ath12k_dp_rx_h_ppdu(ar, rx_info, msdu);
+	if (rx_info->is_invalid_rate_drop) {
 		ret = -EINVAL;
 		goto exit;
 	}
@@ -5134,9 +5144,9 @@ static bool ath12k_dp_rx_h_tkip_mic_err(
 		goto exit;
 	}
 
-	ath12k_dp_rx_h_ppdu(ar, rx_info);
+	ath12k_dp_rx_h_ppdu(ar, rx_info, msdu);
 
-	if (unlikely(rx_info->is_invalid_mcs)) {
+	if (rx_info->is_invalid_rate_drop) {
 		drop = true;
 		goto exit;
 	}
@@ -5261,9 +5271,9 @@ static bool ath12k_dp_rx_h_4addr_null_fr
 		goto exit;
 	}
 
-	ath12k_dp_rx_h_ppdu(ar, rx_info);
+	ath12k_dp_rx_h_ppdu(ar, rx_info, msdu);
 
-	if (unlikely(rx_info->is_invalid_mcs)) {
+	if (unlikely(rx_info->is_invalid_rate_drop)) {
 		ath12k_dbg(ab, ATH12K_DBG_DATA, "4addr Null frame received with invalid mcs\n");
 		drop = true;
 		goto exit;
@@ -5352,6 +5362,7 @@ static void ath12k_dp_rx_wbm_err(struct
 	bool drop = true;
 
 	rx_info.filled = 0;
+	rx_info.is_invalid_rate_drop = 0;
 	rx_info.rx_status = &rxs;
 
 	switch (rxcb->err_rel_src) {
--- a/drivers/net/wireless/ath/ath12k/dp_rx.h
+++ b/drivers/net/wireless/ath/ath12k/dp_rx.h
@@ -152,7 +152,7 @@ struct ath12k_dp_rx_info {
 	bool flow_idx_invalid;
 	bool flow_idx_timeout;
 	u16 flow_metadata;
-	bool is_invalid_mcs;
+	bool is_invalid_rate_drop;
 };
 
 #define ATH12K_DP_MIN_FST_CORE_MASK 0x1
@@ -278,7 +278,8 @@ u8 ath12k_dp_rx_h_decap_type(struct ath1
 			     struct hal_rx_desc *desc);
 u32 ath12k_dp_rx_h_mpdu_err(struct ath12k_base *ab,
 			    struct hal_rx_desc *desc);
-void ath12k_dp_rx_h_ppdu(struct ath12k *ar, struct ath12k_dp_rx_info *rx_info);
+void ath12k_dp_rx_h_ppdu(struct ath12k *ar, struct ath12k_dp_rx_info *rx_info,
+			 struct sk_buff *msdu);
 
 int ath12k_dp_rxdma_ring_sel_config_qcn9274(struct ath12k_base *ab);
 int ath12k_dp_rxdma_ring_sel_config_wcn7850(struct ath12k_base *ab);
