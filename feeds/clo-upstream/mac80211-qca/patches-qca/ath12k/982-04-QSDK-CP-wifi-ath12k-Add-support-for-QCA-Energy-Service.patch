+struct ath12k_hw_group *ath12k_core_get_ag(void)
+{
+	struct ath12k_hw_group *ag;
+
+	mutex_lock(&ath12k_hw_lock);
+
+	if (list_empty(&ath12k_hw_groups)) {
+		ath12k_warn(NULL, "core hw group list is empty\n");
+		mutex_unlock(&ath12k_hw_lock);
+		return NULL;
