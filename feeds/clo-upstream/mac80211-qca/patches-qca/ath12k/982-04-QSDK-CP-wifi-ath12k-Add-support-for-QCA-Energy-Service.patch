+int ath12k_vendor_put_ar_hw_link_id(struct sk_buff *vendor_event,
+				    struct ath12k *ar)
+{
+	if (nla_put_u16(vendor_event,
+			QCA_WLAN_VENDOR_ATTR_LINK_INFO_HW_LINK_ID,
+			ar->pdev->hw_link_id)) {
+		ath12k_err(ar->ab, "Fails to put hw link id :%d for soc:%d",
+			   ar->pdev->hw_link_id, ar->ab->chip_id);
+		return -1;
+	}
+
+	return 0;
+}
