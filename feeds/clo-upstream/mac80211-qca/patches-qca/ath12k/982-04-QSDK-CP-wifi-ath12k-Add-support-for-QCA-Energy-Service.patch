+	if (nla_put_u8(vendor_event, QCA_WLAN_VENDOR_ATTR_LINK_CHAN_BW,
+		       ath12k_nl_chan_bw_to_qca_vendor_chan_bw(ctx->def.width))) {
+		ath12k_err(ar->ab, "Fails to put chan bw for hw link id :%d soc:%d",
+			   ar->pdev->hw_link_id, ar->ab->chip_id);
+		return -1;
+	}
+
+	if (nla_put_u16(vendor_event, QCA_WLAN_VENDOR_ATTR_LINK_CHAN_FREQ,
+			ctx->def.chan->center_freq)) {
+		ath12k_err(ar->ab, "Fails to put chan center freq for hw link id :%d soc:%d",
+			   ar->pdev->hw_link_id, ar->ab->chip_id);
+		return -1;
