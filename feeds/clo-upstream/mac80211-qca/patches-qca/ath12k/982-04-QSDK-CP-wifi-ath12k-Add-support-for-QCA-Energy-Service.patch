+static int
+(*ath12k_vendor_service_init[ATH12K_RM_MAX_SERVICE])(struct ath12k_hw *ah,
+						     struct ath12k_vendor_service_info *info);
+
+static int
+(*ath12k_vendor_service_deinit[ATH12K_RM_MAX_SERVICE])(struct ath12k_hw *ah,
+						       struct ath12k_vendor_service_info *info);
+static void ath12k_vendor_create_soc_agent_resources(const u8 id);
+static void ath12k_vendor_destroy_soc_agent_resources(const u8 id);
+static void ath12k_vendor_create_peer_agent_resources(const u8 id);
+static void ath12k_vendor_destroy_peer_agent_resources(const u8 id);
+
+static int ath12k_vendor_service_common(struct ath12k_hw *ah,
+					struct ath12k_vendor_service_info *info,
+					const u8 event_type, bool enable)
+{
+	if (ath12k_telemetry_notify_vendor_app_event(event_type, info->id, info->service_data))
+		return -EINVAL;
+
+	if (event_type == AGENT_NOTIFY_EVENT_DEINIT)
+		vendor_info.is_vendor_init_done = false;
+
+	vendor_info.service_enabled[info->id] = enable;
+	ath12k_dbg(NULL, ATH12K_DBG_RM,
+		   "vendor svc %s id: %d Enable: %d\n",
+		   (event_type == AGENT_NOTIFY_EVENT_INIT) ? "init" : "deinit",
+		   info->id, vendor_info.service_enabled[info->id]);
+
+	return 0;
+}
+
+static int ath12k_vendor_energy_service_init(struct ath12k_hw *ah,
+					     struct ath12k_vendor_service_info *info)
+{
+	if (vendor_info.service_enabled[info->id])
+		if (ath12k_vendor_service_common(ah, info,
+						 AGENT_NOTIFY_EVENT_DEINIT,
+						 false))
+			return -EINVAL;
+
+	return ath12k_vendor_service_common(ah, info, AGENT_NOTIFY_EVENT_INIT,
+					    true);
+}
+
+static int ath12k_vendor_energy_service_deinit(struct ath12k_hw *ah,
+					       struct ath12k_vendor_service_info *info)
+{
+	return ath12k_vendor_service_common(ah, info,
+					    AGENT_NOTIFY_EVENT_DEINIT, false);
+}
