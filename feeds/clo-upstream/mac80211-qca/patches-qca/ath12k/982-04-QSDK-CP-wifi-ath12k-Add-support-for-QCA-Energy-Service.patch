+
+static int ath12k_vendor_set_wifi_params(struct wiphy *wiphy,
+					 struct wireless_dev *wdev,
+					 struct ath12k_wifi_generic_params *params)
+{
+	struct ieee80211_vif *vif = NULL;
+	struct ath12k_vif *ahvif;
+	struct ath12k_link_vif *arvif;
+	struct ath12k_hw *ah = NULL;
+	struct ath12k *ar = NULL;
+	int param = params->value;
+	u32 *data = (u32 *)params->data;
+	int value = *data;
+	int ret = -1;
+
+	vif = wdev_to_ieee80211_vif(wdev);
+	if (!vif || !data)
+		return -EINVAL;
+
+	ahvif = ath12k_vif_to_ahvif(vif);
+	if (!ahvif || params->ifindex == -1) {
+		return -EINVAL;
+	}
+
+	ah = ahvif->ah;
+
+	if (ah && params->link_id == INVALID_LINK_ID) {
+		mutex_lock(&ah->conf_mutex);
+		arvif = &ahvif->deflink;
+		if (arvif && arvif->ar)
+			ar = arvif->ar;
+		mutex_unlock(&ah->conf_mutex);
+	} else {
+		rcu_read_lock();
+		arvif = ath12k_rcu_get_arvif_from_link_id(ahvif, params->link_id);
+		if (arvif && arvif->ar)
+			ar = arvif->ar;
+		rcu_read_unlock();
+	}
+
+	if (!arvif || !ar)
