+static void
+ath12k_dp_mon_per_user_ppdu_rssi_update(struct ath12k *ar,
+					struct hal_rx_mon_ppdu_info *ppdu_info,
+				       u32 uid)
+{
+	struct hal_rx_user_status *user_stats = &ppdu_info->userstats[uid];
+	struct ath12k_dp_mon_peer_stats *stats = NULL;
+	struct ath12k_peer *peer;
+	u8 rssi_comb;
+
+	if (!ar)
+		return;
+
+	rcu_read_lock();
+	peer = ath12k_peer_find_by_peer_list_index(ar, user_stats->sw_peer_id);
+	if (!peer || !peer->sta) {
+		ath12k_dbg(ar->ab, ATH12K_DBG_PEER,
+			   "peer stats not found on ppdu peer id %d\n",
+			   user_stats->sw_peer_id);
+		rcu_read_unlock();
+		return;
+	}
+	rssi_comb = ppdu_info->rssi_comb;
+	stats = &peer->stats;
+	stats->snr = rssi_comb;
+	if (unlikely(stats->avg_snr == SNR_INVALID))
+		stats->avg_snr = SNR_IN(stats->snr);
+	else
+		SNR_UPDATE_AVG(stats->avg_snr, stats->snr);
+	rcu_read_unlock();
+}
+
 static void ath12k_dp_mon_ppdu_rx_time_update(struct ath12k *ar,
 					      struct hal_rx_mon_ppdu_info *ppdu_info,
 					      bool is_stat)
