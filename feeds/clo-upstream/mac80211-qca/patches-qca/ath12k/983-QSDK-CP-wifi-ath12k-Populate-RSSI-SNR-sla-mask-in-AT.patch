+static u32 ath12k_get_enabled_param_mask(u8 svc_id)
+{
+	struct ath12k_sawf_ctx *sawf_ctx;
+	u32 enabled_param_mask;
+
+	sawf_ctx = ath12k_get_sawf_context();
+	if (!sawf_ctx)
+		return 0;
+
+	if (!ath12k_svc_id_configured(svc_id)) {
+		ath12k_warn(NULL, "Service id: %u not available\n", svc_id);
+		return 0;
+	}
+
+	enabled_param_mask = sawf_ctx->svc_classes[SVC_INDEX(svc_id)].enabled_param_mask;
+
+	return enabled_param_mask;
+}
+
+static u32
+ath12k_get_enabled_sawf_params_mask(struct ath12k_sawf_svc_params *sawf_params)
+{
+	u32 enabled_sawf_params = 0;
+
+	if (sawf_params->min_throughput_rate != SAWF_SVC_PARAM_DEFAULT_MIN_THRUPUT)
+		enabled_sawf_params |= (1 << SAWF_PARAM_MIN_THROUGHPUT);
+	if (sawf_params->max_throughput_rate != SAWF_SVC_PARAM_DEFAULT_MAX_THRUPUT)
+		enabled_sawf_params |= (1 << SAWF_PARAM_MAX_THROUGHPUT);
+	if (sawf_params->burst_size != SAWF_SVC_PARAM_DEFAULT_BURST_SIZE)
+		enabled_sawf_params |= (1 << SAWF_PARAM_BURST_SIZE);
+	if (sawf_params->service_interval != SAWF_SVC_PARAM_DEFAULT_SVC_INTERVAL)
+		enabled_sawf_params |= (1 << SAWF_PARAM_SERVICE_INTERVAL);
+	if (sawf_params->delay_bound != SAWF_SVC_PARAM_DEFAULT_DELAY_BOUND)
+		enabled_sawf_params |= (1 << SAWF_PARAM_DELAY_BOUND);
+	if (sawf_params->msdu_ttl != SAWF_SVC_PARAM_DEFAULT_TIME_TO_LIVE)
+		enabled_sawf_params |= (1 << SAWF_PARAM_MSDU_TTL);
+	if (sawf_params->msdu_rate_loss != SAWF_SVC_PARAM_DEFAULT_MSDU_LOSS_RATE)
+		enabled_sawf_params |= (1 << SAWF_PARAM_MSDU_LOSS);
+
+	return enabled_sawf_params;
+}
+
+void ath12k_get_peer_sla_config(struct ath12k_peer *peer, u16 *sla_mask)
+{
+	struct ath12k_sawf_peer_ctx *peer_ctx = NULL;
+	struct ath12k_sawf_ctx *sawf_ctx;
+	int tid, q_id;
+	u8 svc_id;
+
+	sawf_ctx = ath12k_get_sawf_context();
+	if (!sawf_ctx)
+		return;
+
+	peer_ctx = &peer->sawf_ctx_peer;
+
+	for (tid = 0; tid < ATH12K_SAWF_MAX_TID_SUPPORT; tid++) {
+		for (q_id = 0; q_id < MAX_Q_PER_TID; q_id++) {
+			svc_id = peer_ctx->msduq_table[tid][q_id].svc_id;
+			if (peer_ctx->msduq_table[tid][q_id].is_reserved)
+				*sla_mask |=
+					ath12k_get_enabled_param_mask(svc_id);
+		}
+	}
+}
