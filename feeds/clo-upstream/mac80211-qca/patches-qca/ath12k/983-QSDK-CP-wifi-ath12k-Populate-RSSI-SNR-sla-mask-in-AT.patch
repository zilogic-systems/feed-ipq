 		ath12k_dp_mon_ppdu_per_user_rx_time_update(ar, ppdu_info, uid);
 }
 
+static void ath12k_dp_mon_ppdu_rssi_update(struct ath12k *ar,
+					   struct hal_rx_mon_ppdu_info *ppdu_info)
+{
+	u32 num_users, uid;
+
+	num_users = ppdu_info->num_users;
+	if (num_users > HAL_MAX_UL_MU_USERS)
+		num_users = HAL_MAX_UL_MU_USERS;
+
+	for (uid = 0; uid < num_users; uid++)
+		ath12k_dp_mon_per_user_ppdu_rssi_update(ar, ppdu_info, uid);
+}
