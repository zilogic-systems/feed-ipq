+		else
+			skip_send_peer_del = false;
+
+		ret = ath12k_peer_delete_send(ar, arvif->vdev_id, arsta->addr, skip_send_peer_del);
 		if (ret) {
 			mutex_unlock(&ar->conf_mutex);
 			ath12k_warn(ar->ab,
@@ -715,9 +783,14 @@ int ath12k_ml_link_peers_delete(struct a
 			err_ret = ret;
 			continue;
 		}
+		if (!skip_send_peer_del)
+			arvif->num_peers--;
 		mutex_unlock(&ar->conf_mutex);
 	}
 
+	if (peer_del_all)
+		return err_ret;
+
 	/* Ensure all link peers are deleted and unmapped */
 	links = ahsta->links_map;
 	for_each_set_bit(link_id, &links, ATH12K_NUM_MAX_LINKS) {
--- a/drivers/net/wireless/ath/ath12k/peer.h
