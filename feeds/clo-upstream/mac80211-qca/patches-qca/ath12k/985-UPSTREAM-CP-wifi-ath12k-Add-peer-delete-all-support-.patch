+int ath12k_peer_rhash_cleanup(struct ath12k *ar, u32 vdev_id, const u8 *addr)
+{
+	int ret;
+	struct ath12k_link_vif *arvif = NULL;
+	struct ath12k_base *ab = ar->ab;
