+struct ath12k_peer *ath12k_peer_find_by_ml_peer_vdev_id(struct ath12k_base *ab,
+							int peer_id,
+							int vdev_id)
+{
+	struct ath12k_peer *peer;
+
+	lockdep_assert_held(&ab->base_lock);
+
+	if (peer_id == ATH12K_PEER_ID_INVALID)
+		return NULL;
+
+	if (peer_id & ATH12K_ML_PEER_ID_VALID) {
+		list_for_each_entry(peer, &ab->peers, list)
+			if (peer_id == peer->ml_peer_id && vdev_id == peer->vdev_id)
+				return peer;
+	} else {
+		list_for_each_entry(peer, &ab->peers, list) {
+			if (peer->peer_id == peer_id)
+				return peer;
+		}
+	}
+
+	return NULL;
+}
