 static void
+ath12k_dp_primary_peer_migrate_setup(struct ath12k_dp *dp, void *ctx,
+				     enum hal_reo_cmd_status status)
+{
+	struct ath12k_base *ab;
+	struct ath12k_dp_rx_tid *rx_tid = ctx;
+	struct ath12k_peer *peer;
+	struct ath12k_link_sta *arsta;
+	struct ath12k_sta *ahsta;
+	struct ath12k *ar;
+	struct crypto_shash *tfm = rx_tid->tfm;
+	int ret, tid;
+
+	if (status != HAL_REO_CMD_SUCCESS)
+		goto migration_fail;
+
+	ab = dp->ab->ag->ab[rx_tid->chip_id];
+
+	spin_lock_bh(&ab->base_lock);
+
+	peer = ath12k_peer_find_by_id(ab, rx_tid->peer_id);
+	if (!peer) {
+		ath12k_warn(ab, "failed to find peer for peer_id %d\n", rx_tid->peer_id);
+		spin_unlock_bh(&ab->base_lock);
+		goto migration_fail;
+	}
+
+	ath12k_info(ab, "htt new primary peer to %pM peer_id 0x%x ml_peer_id 0x%x link_id 0x%x chip_id 0x%x\n",
+		    peer->addr, peer->peer_id, peer->ml_peer_id, peer->link_id, rx_tid->chip_id);
+
+	ahsta = ath12k_sta_to_ahsta(peer->sta);
+	arsta = ahsta->link[peer->link_id];
+	if (!arsta || !arsta->arvif || !arsta->arvif->ar) {
+		spin_unlock_bh(&ab->base_lock);
+		goto migration_fail;
+	}
+
+	if (peer->dp_setup_done) {
+		ath12k_warn(ab, "peer tid setup is already done for the peer_id %x in migration event\n",
+			    peer->peer_id);
+		WARN_ON(1);
+		goto migration_success;
+	}
+
+	ar = arsta->arvif->ar;
+
+	for (tid = 0; tid <= IEEE80211_NUM_TIDS; tid++) {
+		rx_tid = &peer->rx_tid[tid];
+
+		ret = ath12k_dp_rx_peer_tid_setup(ar, tid, 1, 0, HAL_PN_TYPE_NONE, peer);
+		if (ret) {
+			ath12k_warn(ab, "failed to setup rxd tid queue for tid %d: %d in migration event\n",
+				    tid, ret);
+			goto peer_tid_clean;
+		}
+	}
+
+	ret = ath12k_dp_rx_peer_frag_setup(ar, peer, tfm);
+	if (ret) {
+		ath12k_warn(ab, "failed to setup rx defrag context for peer_id %x in migration event\n",
+			    peer->peer_id);
+		goto peer_tid_clean;
+	}
+
+migration_success:
+	arsta->arvif->primary_sta_link = true;
+	peer->primary_link = true;
+	spin_unlock_bh(&ab->base_lock);
+	complete(&ahsta->dp_migration_event);
+	return;
+
+peer_tid_clean:
+	for (tid--; tid >= 0; tid--)
+		ath12k_dp_rx_peer_tid_delete(ar, peer, tid);
+	spin_unlock_bh(&ab->base_lock);
+migration_fail:
+	crypto_free_shash(tfm);
+	complete(&ahsta->dp_migration_event);
+}
+
+static int
+ath12k_dp_peer_migrate(struct ath12k_sta *ahsta, u16 peer_id,
+		       u8 chip_id)
+{
+	struct ath12k_base *ab;
+	struct ath12k_peer *peer;
+	struct ath12k_dp_rx_tid *rx_tid;
+	struct ath12k_hal_reo_cmd cmd = {0};
+	struct ath12k_link_sta *arsta;
+	struct ath12k *ar;
+	int ret, tid;
+
+	arsta = ahsta->link[ahsta->primary_link_id];
+	if (!arsta->arvif || !arsta->arvif->ar || !arsta->arvif->ar->ab)
+		goto out;
+
+	ar = arsta->arvif->ar;
+	ab = ar->ab;
+
+	spin_lock_bh(&ab->base_lock);
+
+	peer = ath12k_peer_find(ab,
+				arsta->arvif->vdev_id, arsta->addr);
+	if (!peer || !peer->primary_link) {
+		ath12k_warn(ab,
+			    "failed to fetch primary peer for peer addr %pM in MLO pri link migration event\n",
+			    arsta->addr);
+		goto unlock;
+	}
+
+	ath12k_info(ab, "htt current primary peer  %pM peer_id 0x%x ml_peer_id 0x%x link_id 0x%x\n",
+		    peer->addr, peer->peer_id, peer->ml_peer_id, peer->link_id);
+
+	peer->primary_link = false;
+	arsta->arvif->primary_sta_link = false;
+
+	for (tid = 0; tid <= IEEE80211_NUM_TIDS; tid++) {
+		rx_tid = &peer->rx_tid[tid];
+
+		cmd.addr_lo = lower_32_bits(rx_tid->paddr);
+		cmd.addr_hi = upper_32_bits(rx_tid->paddr);
+		cmd.flag |= HAL_REO_CMD_FLG_NEED_STATUS;
+		ret = ath12k_dp_reo_cmd_send(ab, rx_tid, HAL_REO_CMD_FLUSH_QUEUE,
+					     &cmd, NULL);
+		if (ret) {
+			ath12k_warn(ab, "failed to flush rx tid queue, tid %d (%d)\n",
+				    rx_tid->tid, ret);
+			goto unlock;
+		}
+	}
+
+	cmd.flag = 0;
+	rx_tid = &peer->rx_tid[0];
+	rx_tid->chip_id = chip_id;
+	rx_tid->peer_id = peer_id;
+	rx_tid->tfm = peer->tfm_mmic;
+
+	/* TODO: Synchronize with DP fragment path */
+	peer->tfm_mmic = NULL;
+
+	cmd.addr_lo = lower_32_bits(rx_tid->paddr);
+	cmd.addr_hi = upper_32_bits(rx_tid->paddr);
+	cmd.flag |= HAL_REO_CMD_FLG_NEED_STATUS;
+	cmd.flag |= HAL_REO_CMD_FLG_FLUSH_ALL;
+
+	ret = ath12k_dp_reo_cmd_send(ab, rx_tid,
+				     HAL_REO_CMD_FLUSH_CACHE,
+				     &cmd, ath12k_dp_primary_peer_migrate_setup);
+	if (ret) {
+		ath12k_warn(ab, "failed to flush cache for peer_id %x\n", peer->peer_id);
+		goto unlock;
+	}
+
+	cmd.flag = 0;
+	cmd.flag = HAL_REO_CMD_FLG_UNBLK_CACHE;
+
+	ret = ath12k_dp_reo_cmd_send(ab, rx_tid, HAL_REO_CMD_UNBLOCK_CACHE, &cmd, NULL);
+	if (ret) {
+		ath12k_warn(ab, "failed to unblock cache for peer_id %x\n", peer->peer_id);
+		goto unlock;
+	}
+
+	/* TODO: Synchronize with DP fragment path */
+	ath12k_dp_rx_peer_tid_cleanup(ar, peer);
+	peer->dp_setup_done = false;
+
+	spin_unlock_bh(&ab->base_lock);
+	return 0;
+
+unlock:
+	spin_unlock_bh(&ab->base_lock);
+out:
+	complete(&ahsta->dp_migration_event);
+	return -EINVAL;
+}
