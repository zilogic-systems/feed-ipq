+			 htt_stats_buf->tx_msdu_cong_ctrl_drop_byte_cnt_lo);
+
+	len += scnprintf(buf + len, buf_len - len,
+			 "tx_msdu_ttl_expire_drop_byte_cnt = 0x%08x%08x\n",
+			 htt_stats_buf->tx_msdu_ttl_expire_drop_byte_cnt_hi,
+			 htt_stats_buf->tx_msdu_ttl_expire_drop_byte_cnt_lo);
+
+	len += scnprintf(buf + len, buf_len - len,
 			 "tqm_bypass_frame_cnt = 0x%08x%08x\n",
 			 htt_stats_buf->tqm_bypass_frame_cnt_hi,
 			 htt_stats_buf->tqm_bypass_frame_cnt_lo);
