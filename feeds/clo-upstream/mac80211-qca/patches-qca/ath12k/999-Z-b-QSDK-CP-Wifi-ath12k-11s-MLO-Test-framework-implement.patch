+bool ath12k_11s_mlo_testing_skip_peer_delete_wait(struct ath12k_vif *ahvif,
+						  struct ath12k *ar, const u8 *addr)
+{
+	int sta_arr_idx;
+
+	if (!ath12k_11s_mlo_testing_enable ||
+	    ahvif->vif->type != NL80211_IFTYPE_MESH_POINT ||
+	    !ath12k_11s_mlo_testing_is_preconfigured_11s_mlo_sta(addr))
+		return false;
+
+	for (sta_arr_idx = 0; sta_arr_idx < ATH12K_NUM_11S_MLO_STA_LINKS; sta_arr_idx++) {
+		if ((memcmp(link_sta_info[sta_arr_idx].addr, addr, ETH_ALEN) == 0) &&
+		    link_sta_info[sta_arr_idx].peer_create_sent) {
+			link_sta_info[sta_arr_idx].ar = NULL;
+			link_sta_info[sta_arr_idx].arsta = NULL;
+			link_sta_info[sta_arr_idx].arvif = NULL;
+			link_sta_info[sta_arr_idx].peer_create_sent = 0;
+			num_sta_entries--;
+			ath12k_info(NULL, "11S_MLO_TEST: sta entry deleted for %pM count %d\n",
+				    addr, num_sta_entries);
+
+			return true;
+		}
+	}
+
+	ath12k_info(NULL, "11S_MLO_TEST: sta entry delete notfification with its not created %pM\n",
+		    addr);
+
+	return true;
+}
