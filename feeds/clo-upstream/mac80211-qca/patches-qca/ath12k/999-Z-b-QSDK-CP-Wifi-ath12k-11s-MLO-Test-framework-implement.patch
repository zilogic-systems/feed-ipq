+inline u8 ath12k_11s_mlo_testing_are_all_vaps_up(void)
+{
+	if (!ath12k_11s_mlo_testing_enable)
+		return true;
+
+	return ((num_mlo_vaps == 2) ? 1 : 0);
+}
+
+inline bool ath12k_11s_mlo_testing_is_ml_vif(struct ath12k_vif *ahvif)
+{
+	if (ath12k_11s_mlo_testing_enable &&
+	    ahvif->vif->type == NL80211_IFTYPE_MESH_POINT)
+		return true;
+
+	return false;
+}
+
+inline bool ath12k_11s_mlo_testing_is_preconfigured_11s_mlo_sta(const u8 *addr)
+{
+	int idx;
+
+	if (!ath12k_11s_mlo_testing_enable)
+		return false;
+
+	for (idx = 0; idx < ATH12K_NUM_11S_MLO_STA_LINKS; idx++) {
+		if (memcmp(link_sta_info[idx].addr, addr, ETH_ALEN) == 0)
+			return true;
+	}
+	return false;
+}
+
+inline void
+ath12k_11s_mlo_testing_notify_peer_state(const u8 *addr,
+					 enum ieee80211_sta_state state,
+					 u8 after)
+{
+	unsigned long flags;
+	int link_sta_idx;
+
+	if (!ath12k_11s_mlo_testing_enable)
+		return;
+
+	spin_lock_irqsave(&state_change_lock, flags);
+	for (link_sta_idx = 0; link_sta_idx < ATH12K_NUM_11S_MLO_STA_LINKS;
+	     link_sta_idx++) {
+		if (memcmp(link_sta_info[link_sta_idx].addr, addr, ETH_ALEN) == 0) {
+			link_sta_info[link_sta_idx].state = state;
+			break;
+		}
+	}
+
+	if (after == 1)
+		state_change_in_progress = false;
+	else
+		state_change_in_progress = true;
+
+	spin_unlock_irqrestore(&state_change_lock, flags);
+}
+
+/* Ensure packets are not delivered to mac80211 until both STA's under
+ * MLO operation are in the IEEE80211_STA_AUTHORIZED state for better
+ * synchronization. Currently, ath12k does not delete peer entries in
+ * firmware during NONE->NOEXIST, causing packet delivery to the driver
+ * despite differing STA states in mac80211/supplicant.
+ */
+bool ath12k_11s_mlo_testing_is_drop_packet(void)
+{
+	int link_sta_idx;
+	unsigned long flags;
+
+	if (!ath12k_11s_mlo_testing_enable)
+		return false;
+
+	spin_lock_irqsave(&state_change_lock, flags);
+
+	for (link_sta_idx = 0; link_sta_idx < ATH12K_NUM_11S_MLO_STA_LINKS;
+	     link_sta_idx++) {
+		if (link_sta_info[link_sta_idx].state < IEEE80211_STA_AUTHORIZED ||
+		    state_change_in_progress) {
+			spin_unlock_irqrestore(&state_change_lock, flags);
+			return true;
+		}
+	}
+
+	spin_unlock_irqrestore(&state_change_lock, flags);
+
+	return false;
+}
