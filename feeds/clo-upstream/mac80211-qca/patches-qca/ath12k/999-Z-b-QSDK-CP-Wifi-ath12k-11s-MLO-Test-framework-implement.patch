+void
+ath12k_11s_mlo_testing_notify_add_interface(struct ieee80211_vif *vif,
+					    struct ath12k_link_vif *arvif,
+					    u8 *addr)
+{
+	struct wireless_dev *wdev = ieee80211_vif_to_wdev(vif);
+	struct ath12k_11s_mlo_testing_interfaces *entry = &ath12k_11s_mlo_ifaces[num_mlo_vaps];
+	struct ath12k *ar = arvif->ar;
+	struct ath12k_pdev *pdev = ar->pdev;
+
+	if (!ath12k_11s_mlo_testing_enable ||
+	    !arvif || arvif->ahvif->vif->type != NL80211_IFTYPE_MESH_POINT ||
+	     arvif->link_id == ATH12K_DEFAULT_SCAN_LINK)
+		return;
+
+	if (!wdev->netdev)
+		return;
+
+	if (num_mlo_vaps >= ATH12K_NUM_11S_MLO_IFACES) {
+		ath12k_err(NULL, "No more entries can be added\n");
+		return;
+	}
+
+	/* The lifetime of this entry is tied to arvif->is_started, ensuring
+	 * that vif and arvif can be accessed safely without worrying about
+	 * dangling pointers
+	 */
+	entry->dev = wdev->netdev;
+	entry->arvif = arvif;
+	entry->vif = vif;
+	entry->vdev_id = arvif->vdev_id;
+	entry->hw_link_id = arvif->ar->pdev->hw_link_id;
+	entry->link_sta = NULL;
+	ether_addr_copy(entry->addr, addr);
+	if (pdev->cap.supported_bands & WMI_HOST_WLAN_2G_CAP)
+		entry->band = NL80211_BAND_2GHZ;
+	else if (pdev->cap.supported_bands & WMI_HOST_WLAN_5G_CAP && !ar->supports_6ghz)
+		entry->band = NL80211_BAND_5GHZ;
+	else if (pdev->cap.supported_bands & WMI_HOST_WLAN_5G_CAP && ar->supports_6ghz)
+		entry->band = NL80211_BAND_6GHZ;
+	else
+		ath12k_info(NULL, "11S_MLO_TEST: Unable to determine band info !\n");
+
+	num_mlo_vaps++;
+	ath12k_info(NULL, "11S_MLO_TEST: VAP %pM added as MLO LINK mlo_link_vap_count %d hw_link_id %d band %d\n",
+		    addr, num_mlo_vaps, arvif->ar->pdev->hw_link_id, entry->band);
+}
+
+void
+ath12k_11s_mlo_testing_notify_remove_interface(struct ieee80211_vif *vif,
+					       struct ath12k_link_vif *arvif)
+{
+	int iface_idx;
+
+	if (!ath12k_11s_mlo_testing_enable ||
+	    arvif->ahvif->vif->type != NL80211_IFTYPE_MESH_POINT)
+		return;
+
+	for (iface_idx = 0; iface_idx < ATH12K_NUM_11S_MLO_IFACES; iface_idx++) {
+		if (ath12k_11s_mlo_ifaces[iface_idx].vif == vif &&
+		    ath12k_11s_mlo_ifaces[iface_idx].arvif == arvif) {
+			memset(&ath12k_11s_mlo_ifaces[iface_idx], 0,
+			       sizeof(struct ath12k_11s_mlo_testing_interfaces));
+			num_mlo_vaps--;
+
+			return;
+		}
+	}
+}
