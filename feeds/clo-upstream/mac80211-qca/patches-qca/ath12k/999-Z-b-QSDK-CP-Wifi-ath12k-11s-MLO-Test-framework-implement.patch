+void
+ath12k_11s_mlo_testing_update_vdev_start_mlo_arg(struct ath12k_vif *ahvif,
+						 struct ath12k_link_vif *arvif,
+						 struct wmi_ml_arg *ml_arg)
+{
+	struct ath12k_11s_mlo_testing_interfaces *entry;
+	struct wmi_ml_partner_info *partner_info;
+	int iface_idx = -1, other_iface_idx;
+	int idx;
+
+	for (idx = 0; idx < ATH12K_NUM_11S_MLO_IFACES; idx++) {
+		if (ath12k_11s_mlo_ifaces[idx].arvif == arvif) {
+			iface_idx = idx;
+			other_iface_idx = (idx == 0) ? 1 : 0;
+			break;
+		}
+	}
+
+	if (iface_idx == -1)
+		return;
+
+	if (!ath12k_11s_mlo_testing_enable ||
+	    ahvif->vif->type != NL80211_IFTYPE_MESH_POINT ||
+	    !num_mlo_vaps)
+		return;
+
+	ml_arg->enabled = true;
+	ml_arg->link_add = true;
+	ml_arg->ieee_link_id = arvif->link_id;
+	partner_info = ml_arg->partner_info;
+
+	if (num_sta_entries <= 1)
+		return;
+
+	/* currently supports only 2 link MLD */
+	other_iface_idx = (iface_idx == 0) ? 1 : 0;
+	entry = &ath12k_11s_mlo_ifaces[other_iface_idx];
+	partner_info->vdev_id = entry->vdev_id;
+	partner_info->hw_link_id = entry->hw_link_id;
+	ether_addr_copy(partner_info->addr, entry->addr);
+	ath12k_info(arvif->ar->ab,
+		    "11S_MLO_TEST: added partner info vdev_id %d addr %pM hw_link_id %d band %d\n",
+		    partner_info->vdev_id,  entry->addr, partner_info->hw_link_id, ath12k_11s_mlo_ifaces[other_iface_idx].band);
+
+	ml_arg->num_partner_links++;
+	partner_info++;
+}
