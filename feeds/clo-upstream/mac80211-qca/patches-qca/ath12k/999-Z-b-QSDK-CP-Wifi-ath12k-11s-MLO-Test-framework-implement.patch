+int
+ath12k_11s_mlo_testing_mac_station_add(struct ath12k *ar,
+				       struct ath12k_link_vif *arvif,
+				       struct ath12k_link_sta *arsta)
+{
+	struct ath12k_base *ab = ar->ab;
+	struct ath12k_vif *ahvif = arvif->ahvif;
+	struct ath12k_sta *ahsta = arsta->ahsta;
+	struct ieee80211_sta *sta;
+	struct ath12k_peer *peer = NULL;
+	int ret;
+
+	lockdep_assert_held(&ar->conf_mutex);
+
+	if (!arvif)
+		return -EINVAL;
+
+	sta = container_of((void *)ahsta, struct ieee80211_sta, drv_priv);
+
+	if (ath12k_debugfs_is_extd_rx_stats_enabled(ar) && !arsta->rx_stats) {
+		arsta->rx_stats = kzalloc(sizeof(*arsta->rx_stats), GFP_KERNEL);
+		if (!arsta->rx_stats) {
+			ret = -ENOMEM;
+			goto exit;
+		}
+	}
+
+	if (ath12k_debugfs_is_extd_tx_stats_enabled(ar) && !arsta->tx_stats) {
+		arsta->tx_stats = kzalloc(sizeof(*arsta->tx_stats),
+					  GFP_KERNEL);
+		if (!arsta->tx_stats) {
+			ret = -ENOMEM;
+			goto free_rx_stats;
+		}
+
+		arsta->wbm_tx_stats = kzalloc(sizeof(*arsta->wbm_tx_stats), GFP_KERNEL);
+		if (!arsta->wbm_tx_stats) {
+			ret = -ENOMEM;
+			goto free_tx_stats;
+		}
+	}
+
+	ahsta->ahvif = ahvif;
+	ewma_avg_rssi_init(&arsta->avg_rssi);
+
+	spin_lock_bh(&ab->base_lock);
+	peer = ath12k_peer_find(ab, arvif->vdev_id, arsta->addr);
+	if (!peer) {
+		spin_unlock_bh(&ab->base_lock);
+		ath12k_warn(ab, "failed to find peer %pM on vdev %i after creation\n",
+			    arsta->addr, arvif->vdev_id);
+		goto free_wbm_tx_stats;
+	}
+
+	peer->pdev_idx = ar->pdev_idx;
+	peer->sta = sta;
+	peer->is_bridge_peer = 0;
+
+	spin_unlock_bh(&ab->base_lock);
+
+	return 0;
+
+free_wbm_tx_stats:
+	kfree(arsta->wbm_tx_stats);
+	arsta->wbm_tx_stats = NULL;
+free_tx_stats:
+	kfree(arsta->tx_stats);
+	arsta->tx_stats = NULL;
+free_rx_stats:
+	kfree(arsta->rx_stats);
+	arsta->rx_stats = NULL;
+exit:
+	return ret;
+}
+
+void
+ath12k_11s_mlo_testing_mac_station_remove(struct ath12k *ar,
+					  struct ath12k_link_vif *arvif,
+					  struct ath12k_link_sta *arsta)
+{
+	struct ath12k_sta *ahsta = arsta->ahsta;
+	struct ieee80211_sta *sta;
+
+	if (!ath12k_11s_mlo_testing_enable ||
+	    arvif->ahvif->vif->type != NL80211_IFTYPE_MESH_POINT)
+		return;
+
+	sta = container_of((void *)ahsta, struct ieee80211_sta, drv_priv);
+
+	lockdep_assert_held(&ar->conf_mutex);
+
+	kfree(arsta->tx_stats);
+	arsta->tx_stats = NULL;
+
+	kfree(arsta->wbm_tx_stats);
+	arsta->wbm_tx_stats = NULL;
+
+	kfree(arsta->rx_stats);
+	arsta->rx_stats = NULL;
+	/*
+	 * Remove ahvif reference only when all the links from ahsta is removed
+	 */
+	if (hweight16(ahsta->links_map) <= 1)
+		ahsta->ahvif = NULL;
+}
+
+void ath12k_11s_mlo_testing_handle_tx_skb(struct ath12k_base *ab,
+					  struct ieee80211_vif *vif,
+					  struct sk_buff *skb)
+{
+	struct ath12k_vif *ahvif;
+	struct ieee80211_hdr *hdr;
+
+	if (vif->type != NL80211_IFTYPE_MESH_POINT ||
+	    !ath12k_11s_mlo_testing_enable || !skb)
+		return;
+
+	hdr = (struct ieee80211_hdr *)skb->data;
+	if (!ieee80211_is_data(hdr->frame_control))
+		return;
+
+	ahvif = ath12k_mac_mlo_mesh_update_primary_vif(vif);
+	if (!ahvif) {
+		ath12k_warn(ab,
+			    "11S MLO TX: primary ahvif is NULL\n");
+		ahvif = ath12k_vif_to_ahvif(vif);
+	}
+
+	if (!ath12k_11s_mlo_testing_disable_addr_trans)
+		ath12k_mac_mlo_mesh_h_addr_trans(ab, skb);
+}
+
+void
+ath12k_11s_mlo_testing_fill_ml_peer_param(struct ath12k_base *ab,
+					  struct ath12k_vif *ahvif,
+					  struct ath12k_peer *peer,
+					  u8 pdev_idx)
+{
+	/* support only one peer currently so default assign 0 */
+	int ml_peer_id = 0;
+
+	if (!ath12k_11s_mlo_testing_enable ||
+	    ahvif->vif->type != NL80211_IFTYPE_MESH_POINT ||
+	    !ath12k_11s_mlo_testing_is_preconfigured_11s_mlo_sta(peer->addr))
+		return;
+
+	peer->ml_peer_id = ml_peer_id | ATH12K_ML_PEER_ID_VALID;
+
+	for (int i = 0; i < ATH12K_NUM_11S_MLO_STA_LINKS; i++) {
+		if (memcmp(link_sta_info[i].addr, peer->addr, ETH_ALEN) == 0) {
+			memcpy(peer->ml_addr, link_sta_info[i].mld_addr, ETH_ALEN);
+			break;
+		}
+	}
+
+	peer->mlo = true;
+
+	rcu_assign_pointer(ab->ml_peer_list[ml_peer_id][pdev_idx], peer);
+	ath12k_dbg(ab, ATH12K_DBG_PEER, "11S_MLO_TEST: ML peer: %pM assigned to ML peer list[%d]\n",
+		   peer->addr, peer->ml_peer_id);
+}
+
+#define MAX_KEY_IDX	3
+#define KEY_LENGTH	16
+
+/*
+ * Random predefined keys can be replaced by debugfs use_predef_keys before interface bringup
+ * gtk - repalced for mesh VAPs as well as per mesh peer GTK
+ * ptk - repalced for per mesh peer PTK
+ */
+static u8 ath12k_11s_mlo_gtk[KEY_LENGTH] = {
+	0xd9, 0xd8, 0xc4, 0x38, 0xed, 0xa3, 0x1f, 0x54,
+	0xd4, 0x34, 0xc7, 0x8f, 0x06, 0x6d, 0x11, 0x11
+};
+
+static u8 ath12k_11s_mlo_ptk[KEY_LENGTH] = {
+	0xd9, 0xd8, 0xc4, 0x38, 0xed, 0xa3, 0x1f, 0x54,
+	0xd4, 0x34, 0xc7, 0x8f, 0x06, 0x6d, 0x22, 0x22
+};
+
+static u8 ath12k_11s_mlo_test_skb_ptk[MAX_KEY_IDX][KEY_LENGTH];
+static bool ath12k_11s_mlo_test_skb_ptk_stored[MAX_KEY_IDX];
+
+void ath12k_11s_mlo_testing_free_ptk(const u8 *addr)
+{
+	int key_idx;
+
+	if (!ath12k_11s_mlo_testing_enable || use_predef_keys)
+		return;
+
+	for (key_idx = 0; key_idx < MAX_KEY_IDX; key_idx++) {
+		memset(ath12k_11s_mlo_test_skb_ptk[key_idx], 0, KEY_LENGTH);
+		ath12k_11s_mlo_test_skb_ptk_stored[key_idx] = false;
+	}
+
+	ath12k_warn(NULL, "11S_MLO_TEST: clean ptk for %pM cleared ptk\n", addr);
+}
+
+int
+ath12k_mlo_testing_replace_or_store_ptk(struct wmi_vdev_install_key_arg *arg,
+					u8 *tlv_data)
+{
+	const u8 *addr = arg->macaddr;
+	int key_idx = arg->key_idx;
+	int key_flags = arg->key_flags;
+
+	if (!ath12k_11s_mlo_testing_enable)
+		return -EINVAL;
+
+	if (key_idx < 0 || key_idx >= MAX_KEY_IDX) {
+		ath12k_warn(NULL, "11S_MLO_TEST: get key for %pM Invalid key_idx %d\n",
+			    addr, key_idx);
+		return -EINVAL;
+	}
+
+	if (arg->key_len != KEY_LENGTH) {
+		ath12k_warn(NULL, "11S_MLO_TEST: KEY_LENGTH mismatch %d cannot change any keys \n",
+			    arg->key_len);
+		return -EINVAL;
+	}
+
+	if (use_predef_keys) {
+		if (arg->key_flags == WMI_KEY_PAIRWISE)
+			memcpy(tlv_data, ath12k_11s_mlo_ptk, KEY_LENGTH);
+		else
+			memcpy(tlv_data, ath12k_11s_mlo_gtk, KEY_LENGTH);
+
+		return 0;
+	}
+
+	/* In MLO Mesh, only PTK is expected to match across mesh links.
+	 * GTKs can differ per link similar to MLO AP mode
+	 */
+	if (key_flags != WMI_KEY_PAIRWISE)
+		return 0;
+
+	if (!ath12k_11s_mlo_testing_is_preconfigured_11s_mlo_sta(addr))
+		return 0;
+
+	 /* If key is already present use it*/
+	if (ath12k_11s_mlo_test_skb_ptk_stored[key_idx]) {
+		ath12k_info(NULL, "11S_MLO_TEST: already has PTK at key_idx %d. replaced current one\n",
+			    key_idx);
+		memcpy(tlv_data, ath12k_11s_mlo_test_skb_ptk[key_idx], KEY_LENGTH);
+		return 0;
+	}
+
+	if (key_idx < MAX_KEY_IDX) {
+		memcpy(ath12k_11s_mlo_test_skb_ptk[key_idx], arg->key_data, KEY_LENGTH);
+		ath12k_11s_mlo_test_skb_ptk_stored[key_idx] = true;
+	} else {
+		ath12k_warn(NULL, "11S_MLO_TEST: Key buffer is full\n");
+		return -ENOMEM;
+	}
+
+	ath12k_warn(NULL, "11S_MLO_TEST: stored ptk for %pM at key_idx %d\n",
+		    addr, key_idx);
+
+	return 0;
+}
