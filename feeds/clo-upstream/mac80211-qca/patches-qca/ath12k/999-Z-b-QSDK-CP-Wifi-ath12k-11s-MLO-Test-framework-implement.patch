+	},
+	{
+		.addr = {0x00, 0x03, 0x7f, 0x25, 0xaa, 0x22},
+		.link_id = 1,
+		.link_idx = 1,
+		.vdev_id = 0,
+		.is_primary_link = 1,
+		.is_assoc_link = true,
+		.hw_link_id = 1,
+		.ar = NULL,
+		.arvif = NULL,
+		.arsta = NULL,
+		.is_authorized = 0,
+		.peer_create_sent = 0,
+	}
+};
