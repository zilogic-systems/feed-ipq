+void
+ath12k_11s_mlo_testing_fill_peer_assoc_h_mlo(struct ath12k_vif *ahvif,
+					     struct ath12k_link_sta *arsta,
+					     struct ath12k_wmi_peer_assoc_arg *arg)
+{
+	struct ath12k_link_vif *arvif;
+	struct ath12k_sta *ahsta = arsta->ahsta;
+	struct ieee80211_sta *sta;
+	struct peer_assoc_mlo_params *ml = &arg->ml;
+	u8 cur_sta_arr_idx = 0, partner_sta_arr_idx = 0;
+	struct ath12k_11s_mlo_testing_link_sta_info *link_info;
+
+	if (!ath12k_11s_mlo_testing_enable ||
+	    ahvif->vif->type != NL80211_IFTYPE_MESH_POINT)
+		return;
+
+	sta = container_of((void *)ahsta, struct ieee80211_sta, drv_priv);
+
+	cur_sta_arr_idx = ath12k_11s_mlo_testing_find_arrayidx_by_addr_match(sta->addr);
+	if (cur_sta_arr_idx == -1)
+		return;
+
+	link_info = &link_sta_info[cur_sta_arr_idx];
+	arvif = link_info->arvif;
+	if (!arvif || !arvif->is_started)
+		return;
+
+	ml->enabled = true;
+	ml->assoc_link = link_info->is_assoc_link;
+
+	ml->primary_umac = link_info->is_primary_link;
+	ml->peer_id_valid = true;
+	ml->logical_link_idx_valid = true;
+
+	ether_addr_copy(ml->mld_addr, link_sta_info[1].mld_addr);
+	ml->logical_link_idx = link_info->link_idx;
+	ml->ml_peer_id = 0;
+	ml->ieee_link_id = link_info->link_id;
+	ml->bridge_peer = 0;
+	ml->num_partner_links = 0;
+	/*emlsr */
+	ml->eml_caps = sta->eml_cap;
+
+	if (num_sta_entries <= 1)
+		return;
+
+	/* Pick partner link */
+	partner_sta_arr_idx = (cur_sta_arr_idx == 0) ? 1 : 0;
+	link_info = &link_sta_info[partner_sta_arr_idx];
+
+	ml->partner_info[0].vdev_id = link_info->vdev_id;
+	ml->partner_info[0].hw_link_id = link_info->hw_link_id;
+	ml->partner_info[0].assoc_link = link_info->is_assoc_link;
+	ml->partner_info[0].bridge_peer = 0;
+	ml->partner_info[0].primary_umac = link_info->is_primary_link;
+	ml->partner_info[0].logical_link_idx_valid = true;
+	ml->partner_info[0].logical_link_idx = link_info->link_idx;
+	ml->num_partner_links++;
+
+	ath12k_info(NULL, "11S_MLO_TEST: peer_assoc_params vif %pM mld %pM arsta %pM primary %d assoc_link %d  Partner info  %pM in peer assoc cmd hw_link_id %d assoc_link %d primary_link %d \n",
+		    arvif->addr, link_sta_info[1].mld_addr, arsta->addr, ml->primary_umac, ml->assoc_link,
+		    link_info->addr, link_info->hw_link_id, link_info->is_assoc_link, link_info->is_primary_link);
+}
