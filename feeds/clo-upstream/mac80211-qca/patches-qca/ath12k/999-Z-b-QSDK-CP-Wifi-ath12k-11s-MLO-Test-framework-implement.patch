+void ath12k_11s_mlo_testing_debugfs_init(struct ath12k_base *ab)
+{
+	if (!ath12k_11s_mlo_testing_enable)
+		return;
+
+	/* Disable beaocns when Feature is enabled and user to
+	 * to enable after all VAPS are up */
+	ath12k_block_mesh_beacon_rx = 1;
+
+	debugfs_create_file("test_mlo_mesh", 0600, ab->debugfs_soc, ab,
+			    &fops_test_mlo_mesh);
+	debugfs_create_file("tmm_options", 0600, ab->debugfs_soc, ab,
+			    &fops_tmm_options);
+}
