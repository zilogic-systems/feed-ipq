+/*
+ * NOTE: In 11s MLO testing, two independent SLO stations, as seen by upper
+ * layers, are manipulated to become MLO STA within driver/Firmware/Hardware.
+ * TODO: make single STA from userspace and add additional MLO VAP within
+ *	the framework using device band capabilities.
+ */
+
+/* number of arguments in debugfs for passing config */
+#define ATH12K_11S_MLO_TEST_NUM_ARGS 34
+
+/* Maximum number of MLO mesh interfaces framework currently supports */
+#define ATH12K_NUM_11S_MLO_IFACES 2
+
+/* Maximum number of MLO mesh interfaces framework currently supports */
+#define ATH12K_NUM_11S_MLO_STA_LINKS 2
+
+struct ath12k_11s_mlo_testing_interfaces {
+	struct net_device *dev;
+	struct ath12k_link_vif *arvif;
+	struct ieee80211_vif *vif;
+	u32 vdev_id;
+	u16 hw_link_id;
+	u8 addr[ETH_ALEN] __aligned(2);
+	enum nl80211_band band;
+	struct ath12k_11s_mlo_testing_link_sta_info *link_sta;
+};
