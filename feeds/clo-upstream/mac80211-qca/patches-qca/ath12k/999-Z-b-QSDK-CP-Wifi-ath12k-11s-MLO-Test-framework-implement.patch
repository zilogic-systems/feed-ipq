+int ath12k_11s_mlo_testing_find_arrayidx_by_addr_match(const u8 *addr)
+{
+	int arr_idx;
+
+	for (arr_idx = 0; arr_idx < ATH12K_NUM_11S_MLO_STA_LINKS; arr_idx++) {
+		if (ether_addr_equal(link_sta_info[arr_idx].addr, addr))
+			return arr_idx;
+	}
+
+	return -1;
+}
