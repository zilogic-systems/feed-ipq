+void
+ath12k_11s_mlo_testing_peer_create_notify(struct ath12k *ar, struct ath12k_link_vif *arvif,
+					  struct ath12k_link_sta *arsta,
+					  struct ath12k_wmi_peer_create_arg *arg)
+{
+	struct ath12k *partner_ar;
+	struct ath12k_wmi_peer_create_arg partner_arg = {0};
+	int ret;
+	int iface, link_sta, other_linksta_idx = -1;
+	int iface_idx = -1, other_iface_idx = -1;
+
+	if (!ath12k_11s_mlo_testing_enable ||
+	    arvif->ahvif->vif->type != NL80211_IFTYPE_MESH_POINT ||
+	    !ath12k_11s_mlo_testing_is_preconfigured_11s_mlo_sta(arg->peer_addr))
+		return;
+
+	for (iface = 0; iface < ATH12K_NUM_11S_MLO_IFACES; iface++) {
+		if (ath12k_11s_mlo_ifaces[iface].arvif == arvif) {
+			iface_idx = iface;
+			other_iface_idx = (iface_idx == 0) ? 1 : 0;
+			break;
+		}
+	}
+
+	if (iface_idx == -1)
+		return;
+
+	for (link_sta = 0; link_sta < ATH12K_NUM_11S_MLO_STA_LINKS; link_sta++) {
+		if (memcmp(link_sta_info[link_sta].addr, arg->peer_addr, ETH_ALEN) == 0) {
+			link_sta_info[link_sta].ar = ar;
+			link_sta_info[link_sta].arsta = arsta;
+			link_sta_info[link_sta].arvif = arvif;
+			link_sta_info[link_sta].peer_create_sent = 1;
+			num_sta_entries++;
+			ath12k_info(ar->ab,
+				   "11S_MLO_TEST: sta entry added for %pM for VAP %pM peer_create_sent count %d is_primary_link %d hw_link_id %d band %d\n",
+				   arg->peer_addr, ath12k_11s_mlo_ifaces[iface_idx].addr, num_sta_entries, link_sta_info[link_sta].is_primary_link,
+				   ath12k_11s_mlo_ifaces[iface_idx].hw_link_id, ath12k_11s_mlo_ifaces[iface_idx].band);
+			link_sta_info[link_sta].hw_link_id =
+				ath12k_11s_mlo_ifaces[iface_idx].hw_link_id;
+			ath12k_11s_mlo_ifaces[iface_idx].link_sta = &link_sta_info[link_sta];
+
+			other_linksta_idx = (link_sta == 0) ? 1 : 0;
+			link_sta_info[other_linksta_idx].hw_link_id =
+				ath12k_11s_mlo_ifaces[other_iface_idx].hw_link_id;
+			break;
+		}
+	}
+
+	if (link_sta_info[link_sta].is_primary_link)
+		ath12k_11s_mlo_test_primary_link_iface_idx = iface_idx;
+
+	if (other_linksta_idx == -1) {
+		ath12k_warn(ar->ab, "failed to identify other_linksta_idx in peer notify for %pM\n",
+			    arg->peer_addr);
+		return;
+	}
+	if (link_sta_info[other_linksta_idx].peer_create_sent)
+		return;
+
+	partner_ar = ath12k_11s_mlo_ifaces[other_iface_idx].arvif->ar;
+	partner_arg.ml_enabled = 1;
+	partner_arg.mlo_bridge_peer = 0;
+	partner_arg.peer_type = cpu_to_le32(arg->peer_type);
+	partner_arg.vdev_id = cpu_to_le32(arg->vdev_id);
+	partner_arg.peer_addr = link_sta_info[other_linksta_idx].addr;
+
+	/* send partner peer create to firmware irrespective of state */
+	ret = ath12k_wmi_send_peer_create_cmd(partner_ar, &partner_arg);
+	if (ret)
+		ath12k_warn(ar->ab, "failed to submit PEER_CREATE for partner\n");
+}
