+static ssize_t ath12k_read_tmm_options(struct file *file,
+				       char __user *user_buf,
+				       size_t count, loff_t *ppos)
+{
+	const char buf[] =
+		"keywords to configure different aspects of MLO MESH Testing:\n"
+		"`block` - Block beacons from ath12k dp rx. Default disabled.\n"
+		"`enable` - Enable beacons in dp rx after all VAPs are up.\n"
+		"`disable_addr_trans` - Disable address translation in Datapath TX/RX\n"
+		"`enable_addr_trans` - Enable address translation in Datapath TX/RX\n"
+		"`use_predef_keys` - Replace both GTK and PTK with static keys for debugging\n";
+
+	return simple_read_from_buffer(user_buf, count, ppos, buf, strlen(buf));
+}
+
+static ssize_t ath12k_write_tmm_options(struct file *file,
+					const char __user *user_buf,
+					size_t count, loff_t *ppos)
+{
+	struct ath12k_base *ab = file->private_data;
+	char buf[32] = {0};
+	ssize_t rc;
+	int ret;
+
+	if (!ath12k_11s_mlo_testing_enable)
+		return -EINVAL;
+
+	/* filter partial writes and invalid commands */
+	if (*ppos != 0 || count >= sizeof(buf) || count == 0)
+		return -EINVAL;
+
+	rc = simple_write_to_buffer(buf, sizeof(buf) - 1, ppos, user_buf, count);
+	if (rc < 0)
+		return rc;
+
+	/* drop the possible '\n' from the end */
+	if (buf[*ppos - 1] == '\n')
+		buf[*ppos - 1] = '\0';
+
+	if (!strcmp(buf, "block")) {
+		ath12k_info(ab, "blocking mesh beacons\n");
+		ath12k_block_mesh_beacon_rx = 1;
+		ret = 0;
+	} else if (!strcmp(buf, "enable")) {
+		ath12k_info(ab, "enabling mesh beacons\n");
+		ath12k_block_mesh_beacon_rx = 0;
+		ret = 0;
+	} else if (!strcmp(buf, "disable_addr_trans")) {
+		ath12k_info(ab, "disabling address translation\n");
+		ath12k_11s_mlo_testing_disable_addr_trans = 1;
+		ret = 0;
+	} else if (!strcmp(buf, "enable_addr_trans")) {
+		ath12k_info(ab, "enabling address translation\n");
+		ath12k_11s_mlo_testing_disable_addr_trans = 0;
+		ret = 0;
+	} else if (!strcmp(buf, "use_predef_keys")) {
+		ath12k_info(ab, "Replaces both GTK and PTKs with static keys during key install.\n");
+		use_predef_keys = 1;
+		ret = 0;
+	} else {
+		ret = -EINVAL;
+	}
+
+	if (ret) {
+		ath12k_warn(ab, "failed to configure option %s: %d\n", buf, ret);
+		goto exit;
+	}
+
+	ret = count;
+
+exit:
+	return ret;
+}
+
+static const struct file_operations fops_tmm_options = {
+	.read = ath12k_read_tmm_options,
+	.write = ath12k_write_tmm_options,
+	.open = simple_open,
+	.owner = THIS_MODULE,
+	.llseek = default_llseek,
+};
