+void ath12k_mac_mlo_mesh_h_addr_trans(struct ath12k_base *ab, struct sk_buff *skb)
+{
+	struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
+	u8 from_ds = ieee80211_has_fromds(hdr->frame_control);
+	u8 to_ds = ieee80211_has_tods(hdr->frame_control);
+	u8 *addr1 = hdr->addr1; bool is_addr1_mcast = is_multicast_ether_addr(addr1);
+	u8 *addr2 = hdr->addr2; bool is_addr2_mcast = is_multicast_ether_addr(addr2);
+	u8 *addr3 = hdr->addr3; bool is_addr3_mcast = is_multicast_ether_addr(addr3);
+
+	ath12k_dbg(ab, ATH12K_DBG_DP_TX,
+		   "11S MLO TX: BEFORE TRANS - addr1 %pM addr2 %pM addr3 %pM addr4 %pM mld addr %pM from_ds %d to_ds %d ARP %d PAE %d\n",
+		   hdr->addr1, hdr->addr2, hdr->addr3,
+		   ieee80211_has_a4(hdr->frame_control) ? hdr->addr4 : NULL,
+		   link_sta_info[0].mld_addr, from_ds, to_ds,
+		   skb->protocol == cpu_to_be16(ETH_P_ARP),
+		   skb->protocol == cpu_to_be16(ETH_P_PAE));
+
+	if (from_ds == 0 && to_ds == 0) {
+		if (!is_addr1_mcast)
+			ether_addr_copy(hdr->addr1, link_sta_info[0].mld_addr);//DA
+		if (!is_addr3_mcast)
+			ether_addr_copy(hdr->addr3, global_iface_mld_addr);//BSSID
+	} else if (from_ds == 0 && to_ds == 1) {
+		if (!is_addr1_mcast)
+			ether_addr_copy(hdr->addr1, global_iface_mld_addr);//BSSID
+		if (!is_addr3_mcast)
+			ether_addr_copy(hdr->addr3, link_sta_info[0].mld_addr);//DA
+	} else if (from_ds == 1 && to_ds == 0) {
+		if (!is_addr1_mcast)
+			ether_addr_copy(hdr->addr1, link_sta_info[0].mld_addr);//DA
+		if (!is_addr2_mcast)
+			ether_addr_copy(hdr->addr2, global_iface_mld_addr);//BSSID
+	} else {
+		if (!is_addr1_mcast)
+			ether_addr_copy(hdr->addr1, link_sta_info[0].mld_addr);//RA
+		if (!is_addr2_mcast)
+			ether_addr_copy(hdr->addr2, global_iface_mld_addr);//TA
+	}
+
+	ath12k_dbg(ab, ATH12K_DBG_DP_TX,
+		   "11S MLO TX: AFTER TRANS - addr1 %pM addr2 %pM addr3 %pM addr4 %pM mld addr %pM from_ds %d to_ds %d ARP %d PAE %d\n",
+		   hdr->addr1, hdr->addr2, hdr->addr3,
+		   ieee80211_has_a4(hdr->frame_control) ? hdr->addr4 : NULL,
+		   link_sta_info[0].mld_addr, from_ds, to_ds,
+		   skb->protocol == cpu_to_be16(ETH_P_ARP),
+		   skb->protocol == cpu_to_be16(ETH_P_PAE));
+}
+
+static ssize_t ath12k_write_test_mlo_mesh_configs(struct file *file,
+						  const char __user *user_buf,
+						  size_t count, loff_t *ppos)
+{
+	struct ath12k_base *ab = file->private_data;
+	struct ath12k_11s_mlo_testing_link_sta_info *sta_info = &link_sta_info[0];
+	int ret;
+	char buf[256] = {0};
+	u8 iface_mld_addr[ETH_ALEN], addr1[ETH_ALEN], addr2[ETH_ALEN], mld_addr[ETH_ALEN];
+	int link_id1, link_idx1, vdev_id1, is_primary_link1, is_assoc_link1;
+	int link_id2, link_idx2, vdev_id2, is_primary_link2, is_assoc_link2;
+
+	ret = simple_write_to_buffer(buf, sizeof(buf) - 1, ppos, user_buf, count);
+
+	if (ret <= 0)
+		goto out;
+
+	ret = sscanf(buf,
+		     "%02hhx:%02hhx:%02hhx:%02hhx:%02hhx:%02hhx %d %d %d %d %d %02hhx:%02hhx:%02hhx:%02hhx:%02hhx:%02hhx %d %d %d %d %d %02hhx:%02hhx:%02hhx:%02hhx:%02hhx:%02hhx %02hhx:%02hhx:%02hhx:%02hhx:%02hhx:%02hhx",
+		     &addr1[0], &addr1[1], &addr1[2], &addr1[3], &addr1[4], &addr1[5],
+		     &link_id1, &link_idx1, &vdev_id1, &is_primary_link1, &is_assoc_link1,
+		     &addr2[0], &addr2[1], &addr2[2], &addr2[3], &addr2[4], &addr2[5],
+		     &link_id2, &link_idx2, &vdev_id2, &is_primary_link2, &is_assoc_link2,
+		     &mld_addr[0], &mld_addr[1], &mld_addr[2], &mld_addr[3], &mld_addr[4],
+		     &mld_addr[5],
+		     &iface_mld_addr[0], &iface_mld_addr[1], &iface_mld_addr[2],
+		     &iface_mld_addr[3], &iface_mld_addr[4], &iface_mld_addr[5]);
+
+	if (ret != ATH12K_11S_MLO_TEST_NUM_ARGS) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (memcmp(addr1, addr2, ETH_ALEN) == 0) {
+		ath12k_err(ab, "Addresses must be different\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if ((is_primary_link1 != 0 && is_primary_link1 != 1) ||
+	    (is_primary_link2 != 0 && is_primary_link2 != 1) ||
+	    is_primary_link1 == is_primary_link2) {
+		ath12k_err(ab, "Only one is_primary_link must be set and value must be 0 or 1\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if ((is_assoc_link1 != 0 && is_assoc_link1 != 1) ||
+	    (is_assoc_link2 != 0 && is_assoc_link2 != 1) ||
+	    is_assoc_link1 == is_assoc_link2) {
+		ath12k_err(ab, "Only one is_assoc_link must be set and value must be 0 or 1\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if ((link_idx1 != 0 && link_idx1 != 1) ||
+	    (link_idx2 != 0 && link_idx2 != 1) ||
+	    link_idx1 == link_idx2) {
+		ath12k_err(ab, "link_idx must be unique and one must be 0 and the other 1\n");
+		ret = -EINVAL;
+		goto out;
+	}
+
+	memcpy(sta_info[0].addr, addr1, ETH_ALEN);
+	sta_info[0].link_id = link_id1;
+	sta_info[0].link_idx = link_idx1;
+	sta_info[0].vdev_id = vdev_id1;
+	sta_info[0].is_primary_link = is_primary_link1;
+	sta_info[0].is_assoc_link = is_assoc_link1;
+	memcpy(sta_info[0].mld_addr, mld_addr, ETH_ALEN);
+
+	memcpy(sta_info[1].addr, addr2, ETH_ALEN);
+	sta_info[1].link_id = link_id2;
+	sta_info[1].link_idx = link_idx2;
+	sta_info[1].vdev_id = vdev_id2;
+	sta_info[1].is_primary_link = is_primary_link2;
+	sta_info[1].is_assoc_link = is_assoc_link2;
+	memcpy(sta_info[1].mld_addr, mld_addr, ETH_ALEN);
+
+	memcpy(global_iface_mld_addr, iface_mld_addr, ETH_ALEN);
+	ath12k_info(NULL, "%pM %d %d %d %d %d %pM %d %d %d %d %d mld addr:%pM iface_mld_addr:%pM\n",
+		    sta_info[0].addr, sta_info[0].link_id, sta_info[0].link_idx,
+		    sta_info[0].vdev_id,
+		    sta_info[0].is_primary_link, sta_info[0].is_assoc_link,
+		    sta_info[1].addr, sta_info[1].link_id, sta_info[1].link_idx,
+		    sta_info[1].vdev_id,
+		    sta_info[1].is_primary_link, sta_info[1].is_assoc_link,
+		    sta_info[1].mld_addr,
+		    global_iface_mld_addr);
+
+	ret = count;
+
+out:
+	return ret;
+}
+
+static const struct file_operations fops_test_mlo_mesh = {
+	.write = ath12k_write_test_mlo_mesh_configs,
+	.open = simple_open,
+	.owner = THIS_MODULE,
+	.llseek = default_llseek,
+};
