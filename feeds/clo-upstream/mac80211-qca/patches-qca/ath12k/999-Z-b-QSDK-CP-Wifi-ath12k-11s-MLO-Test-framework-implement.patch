+/* This section is intentionally defined within mac.c as it use  many ath12k mac static functions */
+#ifdef CPTCFG_ATH12K_TEST_FW_FOR_11S_MLO
+static int
+ath12k_11s_mlo_testing_handle_sta_state_transitions(struct ath12k_hw *ah,
+						    struct ath12k_vif *ahvif,
+						    struct ieee80211_sta *sta,
+						    enum ieee80211_sta_state old_state,
+						    enum ieee80211_sta_state new_state)
+{
+	struct ath12k_sta *ahsta = ath12k_sta_to_ahsta(sta);
+	struct wireless_dev *wdev = ieee80211_vif_to_wdev(ahvif->vif);
+	struct ath12k_link_vif *arvif;
+	struct ath12k_link_sta *arsta;
+	u8 link_id = 0;
+	int ret;
+
+	lockdep_assert_held(&ah->conf_mutex);
+
+	/* Proceed with regular flow if
+	 *	1. feature is disabled
+	 *	2. VAP is not MESH TYPE
+	 *	3. not MLO STA as per preconfigured debugfs entries
+	 *	4. netdevice is going down
+	 */
+	if (!ath12k_11s_mlo_testing_enable ||
+	    ahvif->vif->type != NL80211_IFTYPE_MESH_POINT ||
+	    !ath12k_11s_mlo_testing_is_preconfigured_11s_mlo_sta(sta->addr) ||
+	    wdev->is_netdev_going_down)
+		return 0;
+
+	/* Dont allow 11S MLO STA state changes before all VAPS comes up or
+	 *	beacons enabled on DP RX
+	 */
+	if (!ath12k_11s_mlo_testing_are_all_vaps_up() || ath12k_block_mesh_beacon_rx)
+		return -EBUSY;
+
+	/* First time NOEXIST <-> NONE transitions are handled in regular path */
+	if ((old_state == IEEE80211_STA_NONE && new_state == IEEE80211_STA_NOTEXIST) ||
+	    (old_state == IEEE80211_STA_NOTEXIST && new_state == IEEE80211_STA_NONE)) {
+		if (!ath12k_11s_mlo_testing_peer_already_created(sta->addr)) {
+			ath12k_11s_mlo_testing_free_ptk(sta->addr);
+			return 0;
+		}
+	}
+
+	/*
+	 * Ensure not to delete MLO Mesh peers from firmware when connection is unstable
+	 * as each sta may have different state in upper layers and syncronizations
+	 * is difficult to handle due to firmware requirements.
+	 * TODO: handle single STA entry from upper layers and add link peer from ath12k
+	 */
+	if (old_state == IEEE80211_STA_NONE && new_state == IEEE80211_STA_NOTEXIST) {
+		arvif = ath12k_get_arvif_from_link_id(ahvif, link_id);
+		arsta = ahsta->link[link_id];
+		if (!arvif || !arsta)
+			return -EINVAL;
+
+		mutex_lock(&arvif->ar->conf_mutex);
+		ath12k_11s_mlo_testing_mac_station_remove(arvif->ar, arvif, arsta);
+		mutex_unlock(&arvif->ar->conf_mutex);
+
+		ath12k_mac_unassign_link_sta(ah, ahsta, link_id);
+
+		/* bypass rest of ath12k_mac_update_sta_state */
+		return 1;
+	}
+
+	/* if peer entry is already present in firmware, skip only that part */
+	if (old_state == IEEE80211_STA_NOTEXIST && new_state == IEEE80211_STA_NONE) {
+		INIT_WORK(&ahsta->set_4addr_wk, ath12k_sta_set_4addr_wk);
+		ath12k_mac_assign_link_sta(ah, ahsta, &ahsta->deflink,
+					   ahvif, link_id);
+
+		arvif = ath12k_get_arvif_from_link_id(ahvif, link_id);
+		arsta = ahsta->link[link_id];
+		if (!arvif || !arsta)
+			return -EINVAL;
+
+		mutex_lock(&arvif->ar->conf_mutex);
+		ret = ath12k_11s_mlo_testing_mac_station_add(arvif->ar, arvif, arsta);
+		if (ret) {
+			ath12k_warn(NULL,
+				    "11S MLO TEST: Failed to add station NOTEXIST-->NONE for %pM\n",
+				    sta->addr);
+			return ret;
+		}
+		INIT_WORK(&arsta->update_wk, ath12k_sta_rc_update_wk);
+		mutex_unlock(&arvif->ar->conf_mutex);
+
+		/* bypass rest of ath12k_mac_update_sta_state */
+		return 1;
+	}
+
+	/* when unsure always rest of ath12k_mac_update_sta_state process sta state */
+	return 0;
+}
