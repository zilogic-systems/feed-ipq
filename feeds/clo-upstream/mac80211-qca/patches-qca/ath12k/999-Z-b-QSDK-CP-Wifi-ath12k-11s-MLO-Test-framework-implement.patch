 	ret = ath12k_wmi_vdev_start(ar, &arg, restart);
 	if (ret) {
 		ath12k_warn(ar->ab, "failed to %s WMI vdev %i\n",
@@ -16575,6 +16714,8 @@ ath12k_mac_assign_vif_chanctx_handle(str
 
 	/* TODO: Setup ps and cts/rts protection */
 
+	ath12k_11s_mlo_testing_notify_add_interface(vif, arvif, link_conf->addr);
+
 out:
 	mutex_unlock(&ar->conf_mutex);
 
@@ -16757,6 +16898,9 @@ stop_primary:
 
 	arvif->is_started = false;
 
+	/*keep this after is_started = true*/
+	ath12k_11s_mlo_testing_notify_remove_interface(vif, arvif);
+
 	peer = ath12k_peer_find_by_vdev_id(ab, arvif->vdev_id);
 	if (ahvif->vdev_type == WMI_VDEV_TYPE_STA && peer) {
 		if (ath12k_mac_is_bridge_vdev(arvif))
