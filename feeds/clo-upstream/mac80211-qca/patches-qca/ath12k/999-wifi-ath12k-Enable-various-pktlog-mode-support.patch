+	tlv_filter->conf_len_ctrl = HTT_RX_RING_DEFAULT_DMA_LENGTH;
+	tlv_filter->conf_len_mgmt = HTT_RX_RING_DEFAULT_DMA_LENGTH;
+	tlv_filter->conf_len_data = HTT_RX_RING_DEFAULT_DMA_LENGTH;
+	tlv_filter->pkt_filter_flags0 =
