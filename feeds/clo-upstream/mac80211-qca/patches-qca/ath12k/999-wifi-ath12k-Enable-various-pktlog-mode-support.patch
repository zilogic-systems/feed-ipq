+void ath12k_debugfs_set_mon_filter(struct htt_rx_ring_tlv_filter *tlv_filter,
+				   enum ath12k_pktlog_mode mode,
+				   u32 rx_filter)
+{
+	tlv_filter->rx_filter = rx_filter;
