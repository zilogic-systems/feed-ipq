+/**
+ * ath12k_set_pktlog_txrx_filter() - This function is responsible for sending
+ * the TX/ RX/ Hybrid filter settings to FW.
+ *
+ * @mode: Full/ Lite/ Disabled
+ * @filter: TX/ RX/ Hybrid/ rate control debug filter (RCU/ RCF)
+ *         RCU / RCF can be clubbed together TX or RX
+ * @rx_filter: HTT TLV Filter settings. This is mainly responsible for
+ *            pktlog rx. In Pktlog full mode, rx_filter contains all PPDU and
+ *            MPDU TLVs; whereas in Pktlog lite, rx_filter  contains mostly
+ *            PPDU TLVs and MPDU START TLV.
+ */
+int ath12k_set_pktlog_txrx_filter(struct ath12k *ar,
+				  enum ath12k_pktlog_mode mode,
+				  enum ath12k_pktlog_filter filter,
+				  u32 rx_filter)
+{
+	struct htt_rx_ring_tlv_filter tlv_filter = {0};
+	int retv = -EINVAL;
+
+	if (!filter) {
+		ath12k_warn(ar->ab, "failed as filter is not set\n");
+		return -EINVAL;
+	}
+
+	if (mode == ATH12K_PKTLOG_MODE_LITE ||
+	    (filter & ATH12K_PKTLOG_RX)) {
+		ath12k_debugfs_set_mon_filter(&tlv_filter, mode, rx_filter);
+
+		retv = ath12k_pktlog_rx_filter_setting(ar, &tlv_filter);
+		if (retv)
+			ath12k_warn(ar->ab, "failed to set rx filter for "
+				    "mon dest ring %d\n", retv);
+	}
+
+	if (filter & ATH12K_PKTLOG_HYBRID) {
+		retv = ath12k_pktlog_enable_hybrid_mode(ar, filter, mode);
+		if (retv)
+			ath12k_warn(ar->ab, "failed to enable pktlog "
+				    "in hybrid mode %d\n", retv);
+	}
+
+	return retv;
+}
