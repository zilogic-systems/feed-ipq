+		HTT_RX_MON_MO_MGMT_FILTER_FLAGS0;
+	tlv_filter->pkt_filter_flags1 =
+		HTT_RX_MON_FP_MGMT_FILTER_FLAGS1 |
+		HTT_RX_MON_MO_MGMT_FILTER_FLAGS1;
+	tlv_filter->pkt_filter_flags2 =
