+	if (!skb_queue_empty(pcpu_pending)) {
+		tasklet_schedule(&pcpu_tx_pending_tasklet->tasklet);
+	}
 
 	/*
 	 * Calling _ieee80211_wake_txqs here can be a problem because it may
@@ -496,18 +512,22 @@ static void __ieee80211_stop_queue(struc
