 	struct sk_buff *skb;
 	unsigned long flags;
 	int queue, i;
+	spinlock_t *pcpu_queue_stop_reason_lock;
+	struct sk_buff_head *pcpu_pending;
 
-	spin_lock_irqsave(&local->queue_stop_reason_lock, flags);
